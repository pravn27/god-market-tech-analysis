# Machine-local TradingView Desktop MCP bridge for read-only quote fallback.
# Copy this to .env.local and replace the path for the current machine.
TRADINGVIEW_DESKTOP_BRIDGE_CLI=/absolute/path/to/tradingview-mcp/src/cli/index.js
# Optional; defaults to `node` on PATH.
# TRADINGVIEW_DESKTOP_BRIDGE_NODE=/absolute/path/to/node
